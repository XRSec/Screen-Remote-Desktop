#!/bin/bash

set -u

RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
NC="\033[0m"

clear
printf '\nScreen Remote — 打不开修复工具\n\n'

asset_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
app_path="$(find "$asset_directory" -maxdepth 1 -type d -name '*.app' -print -quit)"

if [ -z "$app_path" ]; then
    printf "${RED}修复工具旁未找到 Screen Remote.app。${NC}\n"
    read -r -p "按回车键关闭。"
    exit 1
fi

app_name="$(basename "$app_path")"
installed_app="/Applications/$app_name"

if [ ! -d "$installed_app" ]; then
    printf "${RED}%s 尚未安装，请先将它拖入“应用程序”文件夹。${NC}\n" "$app_name"
    read -r -p "按回车键关闭。"
    exit 1
fi

printf "${YELLOW}请按提示输入 macOS 登录密码；输入时密码不会显示。${NC}\n"
if sudo /usr/bin/xattr -rd com.apple.quarantine "$installed_app"; then
    printf "${GREEN}修复完成，正在打开 %s…${NC}\n" "$app_name"
    open "$installed_app"
else
    printf "${RED}修复失败，应用程序未被修改。${NC}\n"
    read -r -p "按回车键关闭。"
    exit 1
fi

