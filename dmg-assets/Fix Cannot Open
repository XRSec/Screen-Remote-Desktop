#!/bin/bash

set -u

RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
NC="\033[0m"

clear
printf '\nScreen Remote — Fix Cannot Open\n\n'

asset_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
app_path="$(find "$asset_directory" -maxdepth 1 -type d -name '*.app' -print -quit)"

if [ -z "$app_path" ]; then
    printf "${RED}Screen Remote.app was not found next to this repair tool.${NC}\n"
    read -r -p "Press Return to close."
    exit 1
fi

app_name="$(basename "$app_path")"
installed_app="/Applications/$app_name"

if [ ! -d "$installed_app" ]; then
    printf "${RED}%s is not installed yet. Drag it to Applications first.${NC}\n" "$app_name"
    read -r -p "Press Return to close."
    exit 1
fi

printf "${YELLOW}Enter your macOS password when prompted. The password is not shown while typing.${NC}\n"
if sudo /usr/bin/xattr -rd com.apple.quarantine "$installed_app"; then
    printf "${GREEN}Repair complete. Opening %s…${NC}\n" "$app_name"
    open "$installed_app"
else
    printf "${RED}Repair failed. No changes were made to the application.${NC}\n"
    read -r -p "Press Return to close."
    exit 1
fi

