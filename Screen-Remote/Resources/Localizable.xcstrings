    "sessionHelpKeepAwake" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the remote device awake while it is connected and charging."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
