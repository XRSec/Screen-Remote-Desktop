    "sessionHelpLatency" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run 10 independent connection checks for every saved address to compare latency and failures."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
