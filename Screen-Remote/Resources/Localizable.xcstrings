          }
        }
      }
    },
    "sessionHelpFloatingBall" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a floating quick-control button over the remote screen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在远程控制画面上显示悬浮快捷控制按钮。"
          }
        }
      }
    },
    "sessionHelpGameMode" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimize touch and video scheduling for real-time games with independent low-latency video presets."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "针对实时游戏优化触控和视频调度，并使用独立的低延迟视频参数。"
          }
        }
      }
    },
    "sessionHelpGroup" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assign this session to one or more groups in the tree for quick filtering from the sidebar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将会话分配到树中的一个或多个分组，便于在侧边栏快速筛选。"
          }
        }
      }
    },
    "sessionHelpHardwareDecoding" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Mac hardware video decoder to reduce CPU usage and heat. Disable it if a codec compatibility issue occurs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Mac 硬件视频解码器降低 CPU 占用与发热；出现编解码兼容问题时可关闭。"
          }
        }
      }
    },
    "sessionHelpHost" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter an IPv4 address, IPv6 address, or hostname for the remote device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入远程设备的 IPv4、IPv6 地址或主机名。"
          }
        }
      }
    },
    "sessionHelpIgnoreEncoderConstraints" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow video parameters outside the encoder-reported limits. Use only when the device reports incorrect capabilities."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许使用超出编码器报告限制的视频参数；仅在设备能力报告不正确时启用。"
          }
        }
      }
