    "sessionHelpAddresses" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure one primary address and optional fallback addresses. They are tried in priority order."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置一个主会话地址和可选备用地址；连接时按优先级依次尝试。"
          }
        }
      }
    },
    "sessionHelpAudio" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forward remote device audio. Audio requires a supported Android version and is unavailable in compatibility mode."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转发远程设备音频。音频需要受支持的 Android 版本，且兼容模式下不可用。"
          }
        }
      }
    },
    "sessionHelpAudioBitrate" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher bitrates may improve audio quality but consume more bandwidth. 128K is suitable for most sessions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更高码率可能提升音质，但会占用更多带宽；128K 适合大多数会话。"
          }
        }
      }
    },
    "sessionHelpAudioDecoder" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionally choose the local audio decoder. Leave empty to let the system select one."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选本机音频解码器；留空时由系统自动选择。"
          }
        }
      }
    },
    "sessionHelpAudioEncoder" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select a remote-device audio encoder. Leave empty to use the scrcpy default; open the selector to detect supported encoders."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择远程设备的音频编码器。留空使用 scrcpy 默认值；打开选择页面可检测设备支持的编码器。"
          }
        }
      }
    },
    "sessionHelpAudioVolume" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scale playback volume from 100% to 300% without changing the remote device volume."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在不改变远程设备音量的情况下，将播放音量缩放到 100%–300%。"
          }
        }
      }
    },
    "sessionHelpButton" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show help"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示提示"
          }
        }
      }
    },
    "sessionHelpCleanup" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore remote-device state and remove reusable scrcpy resources when the session ends. Disabling this can make the next connection faster."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话结束时恢复远程设备状态并移除可复用的 scrcpy 资源；关闭后可能缩短下次连接准备时间。"
          }
        }
      }
    },
    "sessionHelpClipboard" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronize clipboard content with the remote device. Disable it when clipboard privacy is preferred."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与远程设备同步剪贴板内容；如需保护剪贴板隐私可关闭。"
          }
        }
      }
    },
    "sessionHelpCompatibility" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use ADB screenshots and input commands to bypass scrcpy codec issues. This has higher latency and disables audio, hardware decoding, and clipboard sync."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 ADB 截图和输入命令绕过 scrcpy 编解码问题；延迟更高，并禁用音频、硬件解码与剪贴板同步。"
          }
        }
      }
    },
    "sessionHelpConnectionType" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose TCP/IP, USB serial, or an mDNS service as the ADB transport."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 TCP/IP、USB 序列号或 mDNS 服务作为 ADB 传输方式。"
          }
        }
      }
    },
    "sessionHelpDisplaySize" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional width, height, and density for the new display. Leave all fields empty to use automatic values."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
