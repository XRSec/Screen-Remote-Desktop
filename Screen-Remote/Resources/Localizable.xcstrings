          }
        }
      }
    },
    "sessionHelpDisplaySystemUI" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show system decorations such as status and navigation UI on the virtual display."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
